# Copiar a .env y completar. .env no se versiona.
DATABASE_URL=postgres://blackjack:CAMBIAR@localhost:5432/blackjack
# Al menos 32 caracteres aleatorios.
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_DE_32_O_MAS
BIND_ADDR=127.0.0.1:8080
# Sin BIND_ADDR, la API escucha en 0.0.0.0:$PORT (la variable que inyectan Render o Fly).
# PORT=8080
# Carpeta con el front compilado (dist/): si tiene index.html, la API también sirve el
# front en el mismo origen. La imagen Docker ya la trae en /srv/www.
# STATIC_DIR=../Frontend/dist
# Origen del front: adonde vuelve el login con Google (y CORS de resguardo). El front corre
# en 5180 y llega a la API por su proxy. En producción: https://<dominio>.
FRONTEND_ORIGIN=http://localhost:5180
# true en producción (HTTPS).
COOKIE_SECURE=false
# Límite de tasa de /analyze/* por IP: una petición cada N ms, ráfaga de M.
ANALYZE_REPLENISH_MS=200
ANALYZE_BURST=20
# Ráfaga del límite por IP de registro, login, Google y PATCH /me (luego, 1 cada 6 s).
AUTH_BURST=10
# Ráfaga del límite por usuario de las acciones de juego (luego, 5 por segundo).
PLAY_BURST=10
# Clave secreta de la semilla del reto diario (32 caracteres o más). Sin ella se deriva de
# JWT_SECRET; en producción conviene fijarla para poder rotar JWT_SECRET sin cambiar el
# zapato del día. Quien la conozca puede calcular el zapato de cualquier día.
# DAILY_SEED_SECRET=
# Salas multijugador abiertas a la vez (en memoria; 200 caben de sobra en 1 vCPU).
MAX_ROOMS=200
# Token para GET /api/v1/metrics (32 caracteres o más). Sin él, las métricas no se sirven.
# METRICS_TOKEN=
# Solo con docker compose: contraseña del PostgreSQL del contenedor.
# POSTGRES_PASSWORD=
# Emails de los administradores (moderación), separados por comas. No se guardan en la base.
# ADMIN_EMAILS=
# Proxies cuyo X-Forwarded-For se acepta para saber la IP del cliente: IPs o redes CIDR
# separadas por comas (en Render, 10.0.0.0/8). Sin la variable: 127.0.0.1 y ::1. Vacía: no
# se confía en ninguno.
# TRUSTED_PROXIES=127.0.0.1,::1
# Login con Google. Sin CLIENT_ID y CLIENT_SECRET queda deshabilitado y oculto
# (/auth/providers devuelve google: false). La URI pasa por el proxy de Vite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5180/api/v1/auth/google/callback
